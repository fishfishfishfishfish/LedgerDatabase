{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug scaleBenchmark (with SQLLEDGER)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_debug_sqlledger/bin/scaleBenchmark",
            "args": ["--write-batch=10000", "--read-batch=10000", "--key-length=32", "--value-length=512", "--db-dir=${workspaceFolder}/exps/data"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug scaleBenchmark (with QLDB)",
